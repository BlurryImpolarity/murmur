{
    "name": "@murmur/bot",
    "version": "0.0.1",
    "private": true,
    "main": "./src/index.ts",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "typecheck": "tsc",
        "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js --format=cjs",
        "start": "node dist/index.js",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\""
    },
    "dependencies": {
        "@murmur/db": "*",
        "dotenv": "^17.2.3",
        "drizzle-orm": "^0.45.4",
        "telegraf-hardened": "^6.1.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "esbuild": "^0.28.2",
        "tsx": "^4.23.15"
    }
}
